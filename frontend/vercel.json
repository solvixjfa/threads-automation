{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.ixiera.online"
        }
      ],
      "destination": "https://app.ixiera.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!manifest\\.json|sw\\.js|workbox-.*\\.js|pwa-.*\\.png|apple-touch-icon\\.png|assets/|vite\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
